# Copy to .env — never commit the real file.

# --- backend/app/core/config.py reads these ---
PUBLIC_BASE_URL=http://localhost:8000
ENV=development                      # development | laptop-test | production

# MongoDB Atlas (Free tier for MVP). Least-privileged app user, TLS URI.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=elevator_rf_survey
MONGODB_TLS=true   # set false for a local/dev Mongo (docker, plain mongodb:// with no TLS)

# Auth
JWT_SECRET=change-me-32-bytes-minimum
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# File storage — local for laptop test, s3 later (same storage_key contract)
FILE_STORAGE_BACKEND=local           # local | s3
FILE_STORAGE_ROOT=/absolute/path/outside/this/repo/survey-files

# S3-compatible (only used when FILE_STORAGE_BACKEND=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# CORS — comma-separated explicit origins, no wildcards
CORS_ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost

# Telegram — stays Android-build-injected only (see mobile/.github/workflows/android.yml
# and repo secrets TG_TOKEN / TG_CHAT there). Not read by the backend in MVP.
